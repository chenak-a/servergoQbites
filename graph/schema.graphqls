# GraphQL schema example
#
# https://gqlgen.com/getting-started/

type crypto {
	name: String!
	time: String!
	projection: Float!
	gainlose: GainLoss!
	data: [Data!]!

}
type Data {
	hcl: HCL!
	formula: Formula!
	ai: Ai!
}
# A window of candles for lazy / infinite-scroll loading. `data` is ascending by
# time; `hasMore` is true when older bars exist before the window; `earliest` is
# the opentime of the very first stored bar (the backfill floor).
type CandlePage {
	data: [Data!]!
	hasMore: Boolean!
	earliest: Float!
}
# Lean per-asset metadata (no candle array) so the header/watchlist can render
# without transferring the full multi-year series.
type CryptoMeta {
	name: String!
	time: String!
	projection: Float!
	gainlose: GainLoss!
}
type GainLoss{
	M: Float!
	W: Float!
	D: Float!
}
type HCL {
	opentime: Float!
	Open: Float!
	High: Float!
	Low: Float!
	Close: Float!
	Volume: Float!
}
type Rsi {
	value: Float!
	k: Float!
	d: Float!
}
type Aroon {
	up: Float!
	down: Float!
}
type Macd {
	line: Float!
	histogram: Float!
}
type Zscore {
	value: Float!
	mid: Float!
	hi: Float!
	lo: Float!
}
type Formula {
	rsi: Rsi!
	aroon: Aroon!
	macd: Macd!
	z: Zscore!
	ema: Float!
}
type Ai {
	bigmome: Bigmome!
	sell: Sell!
	smallmome: Smallmome!
	buy: BUY!
	mome: mome!
	other: Other!
}
type Bigmome {
	BUY2: Float!
	BUY1: Float!
	ambi: Float!
}
type Sell {
	amb0: Float!
	amb1: Float!
	amb2: Float!
	amb3: Float!
	amb99: Float!
}
type Smallmome {
	amo: Float!
	ci: Float!
}
type BUY {
	ambb: Float!
	ambb5: Float!
	ww6: Float!
	ww7: Float!
}
type mome {
	amb14: Float!
	amb15: Float!
	amb13: Float!
	amb55: Float!
	amb14p: Float!
	amb15p: Float!
	amb13p: Float!
	amb55p: Float!
}
type Other {
	amo: Float!
	amo1: Float!
	BUYSELL: Float!
	BUYSELLevel: String!
	BUYSELLconf: Float!
	# Signal on the bar it becomes known and tradeable (BUYSELL marks where a
	# top/bottom was; a top is only confirmed bars later). 0 = HOLD.
	ACTION: Float!
	ACTIONconf: Float!
	# Open time (ms) of the bar the action refers to: the top for a SELL.
	ACTIONref: Float!
}
# Backend-computed trading-bot state (regime + signals + backtest). Computed in
# the Python pipeline and merely displayed by the frontend.
type Bot {
	stance: String!
	botMult: Float!
	bhMult: Float!
	emaGapPct: Float!
	startIdx: Int!
	t: [Float!]!
	close: [Float!]!
	ema: [Float!]!
	deepBreak: [Float!]!
	inMarket: [Float!]!
	equity: [Float!]!
	hold: [Float!]!
	entries: [Int!]!
	trims: [Int!]!
	exits: [Int!]!
	swingBuys: [Int!]!
	swingSells: [Int!]!
	cyclePhase: String!
	cycleDay: Int!
}
type User {
	nameuser: String!
	balance:[balance!]!
	
}
type balance {
	cryptoName: String!
	totale: Float!
}

type Query {
  	crypto(name: String!): crypto!
	# Lazy-loaded candle window. `before` is a cursor (opentime); omit it for the
	# most recent `limit` bars, or pass the oldest loaded opentime to backfill.
	candles(name: String!, before: Float, limit: Int!): CandlePage!
	cryptoMeta(name: String!): CryptoMeta!
	User(nameuser: String!): User!
	# Registered assets split by class: crypto pairs (quoted in USDT) and
	# equities/ETFs (quoted in USD).
	symbols: Symbols!
	bot(name: String!): Bot!
}

type Symbols {
	crypto: [String!]!
	stocks: [String!]!
}
